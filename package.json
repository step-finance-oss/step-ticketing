{
  "name": "ticketing",
  "version": "1.0.0",
  "scripts": {
    "reset-db": "npx prisma db push --force-reset && npx prisma db push",
    "predev": "prisma generate &&  prisma migrate dev",
    "dev": "next",
    "dev:only": "next",
    "inngest": "pnpm dlx inngest-cli@latest dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "format": "npm run prettier && npm run lint",
    "prettier": "prettier . \"!pnpm-lock.yaml\" --write --ignore-unknown",
    "lint": "next lint",
    "test": "vitest",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint"
    ],
    "*.{html,css}": "prettier --write"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/client": "5.22.0",
    "@solana/actions": "^1.6.6",
    "@solana/spl-token": "0.4.15",
    "@solana/wallet-adapter-base": "0.9.28",
    "@solana/wallet-adapter-phantom": "0.9.30",
    "@solana/wallet-adapter-react": "0.15.40",
    "@solana/wallet-adapter-react-ui": "0.9.40",
    "@solana/wallet-adapter-solflare": "0.6.34",
    "@solana/web3.js": "1.99.0",
    "@tanstack/react-query": "^5.74.4",
    "@types/papaparse": "^5.3.15",
    "csp-header": "^6.1.0",
    "file-saver": "^2.0.5",
    "inngest": "3.54.2",
    "lodash": "4.18.1",
    "next": "15.5.29",
    "next-auth": "4.24.15",
    "nodemailer": "10.6.1",
    "papaparse": "^5.5.2",
    "prisma": "5.22.0",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "8.0.0",
    "tailwind-merge": "^3.0.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@inngest/test": "^0.1.5",
    "@tailwindcss/forms": "0.5.9",
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.19.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "18.3.32",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.4.20",
    "eslint": "8",
    "eslint-config-next": "15.5.29",
    "eslint-config-prettier": "9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "postcss": "8.5.34",
    "prettier": "3.3.3",
    "tailwindcss": "3.4.14",
    "typescript": "5.9.3",
    "vitest": "^3.2.7",
    "vitest-mock-extended": "^2.0.2"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "next>postcss": "$postcss"
    }
  }
}
