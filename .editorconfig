# http://editorconfig.org
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{ts,tsx,js,mjs,mts,css}]
indent_size = 2

# The JSON files contain newlines inconsistently
[*.{json,jsonc}]
insert_final_newline = ignore
indent_size = 2
